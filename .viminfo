"1	LINE	0
	
	def calc_hessian(self, model, loss_fn, num_samples, device_id, use_train=False):
	    """
	    Compute (top_eig, trace) of the Hessian for `model` w.r.t. `loss_fn`.
	    Ensures *everything* lives on self.gpu_id to avoid device mismatch.
	    """
	    # 0) Fix target device for this rank
	    target_dev = torch.device(f"cuda:{self.gpu_id}") if torch.cuda.is_available() else torch.device("cpu")
	
	    # 1) Put the (copied) model on the right device and in eval mode
	    model = model.to(target_dev).eval()
	
	    # 2) Paranoia pass: make sure every param/buffer is on target_dev
	    with torch.no_grad():
	        for name, p in model.named_parameters(recurse=True):
	            if p.device != target_dev:
	                p.data = p.data.to(target_dev)
	        for name, b in model.named_buffers(recurse=True):
	            if b.device != target_dev:
	                b.data = b.data.to(target_dev)
	
	    # 3) Build inputs on the same device
	    if use_train:
	        # Take up to num_samples from the (possibly Tensor) dataset
	        ds = getattr(self.train_data, "dataset", None)
	        if isinstance(ds, torch.Tensor):
	            inputs = ds[:min(num_samples, ds.shape[0])].to(target_dev, non_blocking=True)
	        else:
	            collected, total = [], 0
	            for batch in self.train_data:
	                batch_inputs = batch[0] if isinstance(batch, (list, tuple)) else batch
	                take = min(batch_inputs.shape[0], num_samples - total)
	                collected.append(batch_inputs[:take])
	                total += take
	                if total >= num_samples:
	                    break
	            inputs = torch.cat(collected, dim=0).to(target_dev, non_blocking=True)
	    else:
	        # Fresh random integers in [0, 2^N) on target_dev
	        inputs = torch.randint(0, 2**self.N, (num_samples,), device=target_dev)
	
	    # 4) Targets from your Boolean function — also on target_dev
	    targets = self.func_batch(inputs).to(target_dev, non_blocking=True)
	
	    # 5) Final guards (helpful if anything slipped through)
	    for name, p in model.named_parameters():
	        assert p.device == target_dev, f"Param {name} on {p.device}, expected {target_dev}"
	    for name, b in model.named_buffers():
	        assert b.device == target_dev, f"Buffer {name} on {b.device}, expected {target_dev}"
	    assert inputs.device == target_dev and targets.device == target_dev, "Data not on target device"
