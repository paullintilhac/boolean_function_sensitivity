import os, sys, ctypes
import torch
print("exe:", sys.executable)
print("torch:", torch.__version__, " cuda:", torch.version.cuda)
print("torch file:", torch.__file__)
print("CUDA_VISIBLE_DEVICES:", os.environ.get("CUDA_VISIBLE_DEVICES"))
# Can we load the driver?
try:
    ctypes.CDLL("libcuda.so")
    print("dlopen libcuda.so: OK")
except OSError as e:
    print("dlopen libcuda.so: FAIL ->", e)
# Force CUDA context init and print the exception if any
try:
    torch.cuda.current_device()     # triggers lazy init
    print("CUDA init OK; device_count:", torch.cuda.device_count(),
          "name:", torch.cuda.get_device_name(0))
except Exception as e:
    print("CUDA init FAILED ->", type(e).__name__, e)
exit()
